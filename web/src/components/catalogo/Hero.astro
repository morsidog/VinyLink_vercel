---
import { Image } from "astro:assets";

interface Props {
  imagen?: string;
}

const { imagen } = Astro.props;
---

<section class:list={["hero", { "hero--foto": imagen }]}>
  {imagen && (
    <Image
      src={imagen}
      alt=""
      width={1600}
      height={700}
      widths={[480, 800, 1200, 1600]}
      sizes="100vw"
      format="webp"
      quality={70}
      priority
      class="hero__img"
      fetchpriority="high"
    />
  )}
  <div class="hero__contenido">
    <h1>Música e instrumentos de todo tipo para todo tipo de personas</h1>
    <p>Explora nuestras categorías y arma tu pedido en minutos.</p>
  </div>
</section>